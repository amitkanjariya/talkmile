name = "talkmile-gateway"
main = "src/index.js"
compatibility_date = "2026-10-01"

# Choose a model currently supported by your Gemini API project and set
# GEMINI_MODEL as a Worker environment variable.
# Shared access: set GEMINI_API_KEY, GEMINI_API_KEY_2, GEMINI_API_KEY_3, etc.
# using `wrangler secret put`. Numbered backups are
# tried after quota failures; adding a secret does not require an APK rebuild.
# Personal-key mode still passes the user's own key per request.
# Never put secret values in this file or the Flutter application.
# DAILY_REQUEST_LIMIT defaults to 450 per Gemini key; the global daily cap
# defaults to 45000. Both KV limits are best-effort, not strict atomic limits.

[[kv_namespaces]]
binding = "USAGE"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
